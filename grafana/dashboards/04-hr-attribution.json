{
  "uid": "finops-04-hr-attribution",
  "title": "HR Cost Attribution",
  "tags": [
    "finops",
    "hr",
    "people"
  ],
  "timezone": "browser",
  "schemaVersion": 37,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-90d",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "department",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(finops_demo_headcount_active, department)",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "barchart",
      "title": "Active Headcount by Department & Role",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 14,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "finops_demo_headcount_active{department=~\"$department\"}",
          "legendFormat": "{{department}} / {{role_category}}",
          "refId": "A",
          "instant": true,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0
        }
      },
      "options": {
        "groupWidth": 0.7,
        "xField": "department"
      }
    },
    {
      "id": 2,
      "type": "piechart",
      "title": "People Cost by Department",
      "gridPos": {
        "x": 14,
        "y": 0,
        "w": 10,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "finops_demo_people_cost_monthly_eur{department=~\"$department\"}",
          "legendFormat": "{{department}}",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyEUR"
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Headcount Growth Trend",
      "description": "Total active FTE per department over 90-day period. Teams growing by ~2 FTE.",
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 16,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum by (department) (finops_demo_headcount_active{department=~\"$department\"})",
          "legendFormat": "{{department}}",
          "refId": "A",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        }
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Total Headcount",
      "gridPos": {
        "x": 16,
        "y": 9,
        "w": 8,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(finops_demo_headcount_active)",
          "legendFormat": "Total FTE",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value"
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Total Monthly People Cost",
      "gridPos": {
        "x": 16,
        "y": 13,
        "w": 8,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(finops_demo_people_cost_monthly_eur)",
          "legendFormat": "Total People Cost",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyEUR"
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value"
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Monthly People Cost Trend",
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "finops_demo_people_cost_monthly_eur{department=~\"$department\"}",
          "legendFormat": "{{department}}",
          "refId": "A",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyEUR",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        }
      }
    }
  ]
}